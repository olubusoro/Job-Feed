# ── App ───────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
INVITE_CODE=friends-only
ADMIN_EMAIL=you@example.com

# ── Database ──────────────────────────────────────────────────────────────────
# SQLite (default, good for local/Render single-instance):
DATABASE_URL=sqlite:///./jobfeed.db
# PostgreSQL (Railway/Render managed Postgres):
# DATABASE_URL=postgresql+psycopg2://user:password@host:5432/jobfeed

# ── Scheduler ────────────────────────────────────────────────────────────────
FETCH_INTERVAL_HOURS=3

# ── HTTP ─────────────────────────────────────────────────────────────────────
HTTP_TIMEOUT=10
HTTP_MAX_WORKERS=15
HTTP_MAX_RETRIES=3

# ── Debug ─────────────────────────────────────────────────────────────────────
DEBUG=false
